# Copia a .env solo la primera vez. Nunca incluir claves reales en Git.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
CAMPUS_ENV=local
GOOGLE_CLOUD_PROJECT=demo-campus
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CAMPUS_PILOT_UIDS=
CAMPUS_PILOT_EMAILS=
CAMPUS_DAILY_TOKEN_BUDGET=100000
# Vacío: archivos privados locales en .data/objects. GCS requiere billing activado.
CAMPUS_STORAGE_BUCKET=
CAMPUS_STORAGE_PROJECT=educloud-513604
# En Cloud Run se requiere una clave persistente desde Secret Manager.
CAMPUS_UPLOAD_SIGNING_KEY=
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-campus
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-campus.firebaseapp.com
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_RENDERER_ORIGIN=http://127.0.0.1:5174
